# Configuration reference only. run.py does NOT automatically load this file.
# Keep AI disabled until account eligibility and API billing are checked.
KARMOLAB_AI_ENABLED=0
GEMINI_API_KEY=
# Set an available Gemini Developer API model ID after checking AI Studio.
KARMOLAB_GEMINI_MODEL=
# Counts attempted calls, including failures. Resets at UTC midnight.
KARMOLAB_AI_DAILY_LIMIT=2
# Never put credentials in dist/ or browser JavaScript.
# Default launch (local observations only): python3 run.py --port 8767
